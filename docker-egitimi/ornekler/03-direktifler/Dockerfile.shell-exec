FROM alpine:3.20
ENV SEHIR=Ankara
# Shell form: /bin/sh -c ile çalışır -> $SEHIR genişletilir
# Exec form (JSON dizi): shell YOK -> "$SEHIR" olduğu gibi yazılır
# İkisini de görmek için RUN satırlarındaki çıktıya bakın (--progress=plain)
RUN echo "shell form  -> $SEHIR"
RUN ["echo", "exec form   -> $SEHIR"]
CMD ["sh", "-c", "echo \"CMD icinde sh -c ile -> $SEHIR\""]
